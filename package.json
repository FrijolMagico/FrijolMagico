{
  "name": "frijolmagico",
  "version": "4.10.0",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.0.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "db:migrate": "echo 'Choose db:migrate:staging or db:migrate:production; no implicit migration target' && exit 1",
    "db:migrate:staging": "bun --cwd packages/database run migrate:staging",
    "db:migrate:production": "bun --cwd packages/database run migrate:production",
    "format": "prettier --write \"**/*.{ts,tsx,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "semver": "^7.8.5",
    "turbo": "^2.10.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "eslint": "9.39.4"
  }
}
