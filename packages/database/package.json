{
  "name": "@frijolmagico/database",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./orm": {
      "types": "./src/drizzle.ts",
      "default": "./src/drizzle.ts"
    },
    "./schema": {
      "types": "./src/db/schema/index.ts",
      "default": "./src/db/schema/index.ts"
    },
    "./filters": {
      "types": "./src/filters.ts",
      "default": "./src/filters.ts"
    },
    "./sql": {
      "types": "./src/sql.ts",
      "default": "./src/sql.ts"
    }
  },
  "scripts": {
    "migrate": "bun run --env-file .env.local drizzle-kit migrate --config drizzle.config.ts",
    "new": "bun run --env-file .env.local drizzle-kit generate --custom --name",
    "seed": "bun run scripts/seed.ts",
    "dev": "turso dev --db-file local.dev.db",
    "prod": "turso dev --db-file local.db",
    "lint": "eslint .",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@frijolmagico/eslint-config": "workspace:*",
    "@frijolmagico/typescript-config": "workspace:*",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "9",
    "typescript": "^5.9.3"
  }
}
