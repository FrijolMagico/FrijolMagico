{
  "name": "@frijolmagico/database",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./orm": {
      "types": "./src/drizzle.ts",
      "default": "./src/drizzle.ts"
    },
    "./active-festival-display": {
      "types": "./src/active-festival-display.ts",
      "default": "./src/active-festival-display.ts"
    },
    "./schema": {
      "types": "./src/db/schema/index.ts",
      "default": "./src/db/schema/index.ts"
    },
    "./filters": {
      "types": "./src/filters.ts",
      "default": "./src/filters.ts"
    },
    "./sql": {
      "types": "./src/sql.ts",
      "default": "./src/sql.ts"
    }
  },
  "scripts": {
    "migrate:staging": "bun --env-file=.env.local run drizzle-kit migrate --config=drizzle-staging.config.ts",
    "migrate:production": "bun --env-file=.env.local run drizzle-kit migrate --config=drizzle-production.config.ts",
    "migrate:ci": "bun --no-env-file run drizzle-kit migrate --config=drizzle-ci.config.ts",
    "new": "bun run drizzle-kit generate --custom --name",
    "pull:staging": "bun --env-file=.env.local run scripts/pull-turso-snapshot.ts staging",
    "pull:production": "bun --env-file=.env.local run scripts/pull-turso-snapshot.ts production",
    "lint": "eslint .",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@frijolmagico/eslint-config": "workspace:*",
    "@frijolmagico/typescript-config": "workspace:*",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "9",
    "typescript": "^5.9.3"
  }
}
