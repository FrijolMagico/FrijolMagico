{
  "extends": "@frijolmagico/typescript-config/next",
  "compilerOptions": {
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../admin/"
  ]
}
