{
  "$schema": "https://v2-10-7.turborepo.dev/schema.json",
  "ui": "tui",

  "globalEnv": ["NODE_ENV", "VERCEL_ENV", "DATA_SOURCE"],
  "globalDependencies": [".env*"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "TURSO_DATABASE_URL",
        "TURSO_DATABASE_NAME",
        "TURSO_AUTH_TOKEN",
        "GOOGLE_API_KEY",
        "CATALOG_SHEET_ID",
        "APPROVED_ARTISTS_SHEET_ID",
        "FESTIVAL_2025_SCHEDULE_SHEET_ID",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_API_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "REVALIDATION_SECRET",
        "CRON_SECRET",
        "WEB_REVALIDATION_URL",
        "CRONITOR_BASE_URL",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "R2_PUBLIC_URL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },

    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "lint:fix": {
      "cache": false,
      "outputs": []
    },

    "test": {
      "cache": false,
      "outputs": []
    },

    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "db:migrate": {
      "cache": false,
      "env": ["TURSO_DATABASE_URL", "TURSO_AUTH_TOKEN"]
    }
  }
}
